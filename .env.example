# =============================================================================
# NARA PROJECT — Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya
# =============================================================================

# --- SUMBER KAMERA ---
# Kamera dipilih di layar Persiapan (webcam 0-3 atau ESP yang ketemu otomatis).
# Pilihan terakhir disimpan di settings.json (jangan di-commit).
# --source pada perintah python app.py menimpa pilihan itu untuk satu kali jalan.
# CAMERA_SOURCE hanya dipakai jika settings.json belum punya kamera dan --source kosong.
# Nilai: "0" untuk webcam laptop, atau URL MJPEG, contoh: http://192.168.1.100:81/stream
CAMERA_SOURCE=0

# --- JARINGAN ESP (mDNS + UDP) ---
# Aplikasi mencari layanan _nara._tcp (UDP 5353) dan siaran "NARA_DISCOVER" ke port 4210.
# Jika Windows Firewall memblokir, izinkan python.exe untuk UDP 5353 dan 4210 di jaringan privat.
# Kontrak perangkat (pairing, /play, /volume, stream) dan wiring: firmware/nara_esp32s3/README.md
# Jaringan dengan client isolation: isi IP ESP lewat tombol "Tambah IP" di layar Persiapan.

# --- INTERVAL UPDATE TELEMETRY (detik) ---
# Mengontrol seberapa sering data CV & ML dikirim ke dashboard via WebSocket
# Default: 1.0 — update setiap 1 detik
# Hemat resource: 3.0 — update setiap 3 detik
# Sangat responsif: 0.25 — update 4x per detik
TELEMETRY_INTERVAL_SEC=3.0
